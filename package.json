{
  "name": "bulkbro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:mobile": "node scripts/mobile-dev.mjs",
    "mobile:android:dev": "node scripts/mobile-android-dev.mjs",
    "mobile:android:share": "node scripts/mobile-apk-share.mjs",
    "mobile:ios:dev": "node scripts/mobile-ios-dev.mjs",
    "mobile:ios:icon": "node scripts/generate-ios-icon.mjs",
    "mobile:sync": "npm run build && cap sync",
    "build": "tsc --noEmit && vite build && node scripts/stamp-sw.mjs && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs",
    "start": "node build/server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "node tests/pwa-smoke.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "openai": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.52.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4",
    "supertest": "^7.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
