PORT=3001
DATABASE_PATH=./data/bulkbro.sqlite
APP_ORIGIN=http://localhost:5188
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY is read from the server environment. Never use a VITE_ prefix.
